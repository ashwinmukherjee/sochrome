{
  "name": "genome-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Ashwin Mukherjee",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsx tools/tokens.ts --check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:preview": "tsx tools/deploy-preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "brand": "tsx tools/brand.ts && tsx tools/third-party.ts",
    "third-party": "tsx tools/third-party.ts",
    "og": "tsx tools/og-image.ts",
    "fixtures": "tsx tools/make-fixtures.ts",
    "verify": "tsx tools/verify.ts",
    "verify:clinvar": "tsx tools/verify.ts C3",
    "tokens": "tsx tools/tokens.ts",
    "bundle": "tsx tools/build-bundle.ts",
    "samples": "tsx tools/build-samples.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "pako": "2.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pako": "2.0.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "knip": "5.88.1",
    "prettier": "3.10.1",
    "puppeteer-core": "25.18.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
